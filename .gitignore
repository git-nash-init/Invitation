# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files: never commit real values, only the example
.env*
!.env.example

# local tooling and pre-rebuild files
/.claude/
/_legacy/
/.mcp.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# generated preview media and raw assets
/previews-out/
/assets-in/

.vercel
.env*

# Licensed music is never committed: add tracks through Admin > Music
*.mp3
*.m4a
.claude/skills/
# Written by the Cashfree skills installer for the local AI assistant
/CLAUDE.md
