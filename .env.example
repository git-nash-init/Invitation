# Supabase project (Settings -> API). Only the publishable key belongs here.
# Never add the service_role key to this app.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Public origin of the site, used for auth redirects and share links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Signs the short-lived links that unlock template files. Required in production.
# Make one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ASSET_TOKEN_SECRET=

# Razorpay (test keys start with rzp_test_). The secret and webhook secret are server only.
RAZORPAY_KEY_ID=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Shared with the database (stored in Supabase Vault as payment_bridge_secret). At least 32 characters.
PAYMENT_BRIDGE_SECRET=

# Shown on the Contact page (Razorpay checks these exist).
NEXT_PUBLIC_BUSINESS_NAME=Pratham Invitation
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_SUPPORT_PHONE=
NEXT_PUBLIC_BUSINESS_ADDRESS=
